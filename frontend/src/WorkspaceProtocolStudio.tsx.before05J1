import {useCallback,useEffect,useState} from 'react';
import {authFetch} from './authClient';
import './workspace-protocol-studio.css';

const API=import.meta.env.VITE_API_BASE_URL||'http://127.0.0.1:8001';
type Workspace={id:string;name:string;role:string};
type Rule={id:string;code:string;title:string;pattern:string;version:number};
type TestCase={id:string;rule_code:string;note:string;expected_match:boolean;actual_match:boolean|null;passed:boolean};
type Release={id:string;number:number;snapshot_hash:string;note:string;published_at:string};
type Preview={active_rules:Rule[];active_hash:string;current_release:(Release&{rules:Rule[]})|null;next_number:number;change:{added:string[];removed:string[];modified:string[]};tests:TestCase[];test_passed:number;test_failed:number;eligible:boolean;limitation:string};
type DraftImpact={draft_id:string;title:string;version:number;channel:string;has_approval:boolean;status:string;needs_retest:boolean;matched_rules:string[];approval_needs_revalidation:boolean};
type Impact={current_release:number|null;published_matches_active:boolean;active_rules:number;draft_count:number;retest_count:number;approvals_at_risk:number;drafts:DraftImpact[];limitation:string};
async function request<T>(path:string,init:RequestInit={}):Promise<T>{
 const res=await authFetch(`${API}${path}`,{...init,headers:{'Content-Type':'application/json',...init.headers}});
 if(!res.ok){const body=await res.json().catch(()=>({detail:`HTTP ${res.status}`}));throw new Error(typeof body.detail==='string'?body.detail:`HTTP ${res.status}`)}
 return res.json();
}
export default function WorkspaceProtocolStudio({onOpenDraft}:{onOpenDraft?:(workspaceId:string,draftId:string)=>void}){
 const [workspaces,setWorkspaces]=useState<Workspace[]>([]),[workspaceId,setWorkspaceId]=useState('');
 const [preview,setPreview]=useState<Preview|null>(null),[impact,setImpact]=useState<Impact|null>(null),[releases,setReleases]=useState<Release[]>([]);
 const [note,setNote]=useState(''),[busy,setBusy]=useState(false),[error,setError]=useState(''),[notice,setNotice]=useState('');
 const workspace=workspaces.find(w=>w.id===workspaceId);
 const refresh=useCallback(async()=>{
  if(!workspaceId)return;
  const scope=`/workspaces/${encodeURIComponent(workspaceId)}/protocol`;
  const [p,i,r]=await Promise.all([request<Preview>(`${scope}/preview`),request<Impact>(`${scope}/impact`),request<Release[]>(`${scope}/releases`)]);
  setPreview(p);setImpact(i);setReleases(r);
 },[workspaceId]);
 useEffect(()=>{request<Workspace[]>('/workspaces').then(w=>{setWorkspaces(w);setWorkspaceId(w[0]?.id||'')}).catch(e=>setError(String(e)))},[]);
 useEffect(()=>{setPreview(null);setImpact(null);setReleases([]);setError('');refresh().catch(e=>setError(e instanceof Error?e.message:String(e)))},[refresh]);
 async function publish(){if(!preview||!workspaceId)return;
  setBusy(true);setError('');setNotice('');
  try{
   const r=await request<Release>(`/workspaces/${encodeURIComponent(workspaceId)}/protocol/releases`,{
    method:'POST',body:JSON.stringify({note,expected_hash:preview.active_hash})});
   setNotice(`Policy release v${r.number} published as an immutable snapshot. Existing drafts are not automatically retested.`);
   setNote('');await refresh();
  }catch(e){setError(e instanceof Error?e.message:String(e))}finally{setBusy(false)}
 }
 const unchanged=!!preview?.current_release && preview.current_release.snapshot_hash===preview.active_hash;
 return <div className="ps-root">
  <section className="ps-intro"><span className="ps-kicker">PROTOCOL STUDIO / RIPPLEMAP · BUILD 05J</span><h2>Every policy change leaves a trail.</h2><p>Capture an immutable version of active workspace rules, run existing regression cases, and identify drafts whose recorded checks no longer match policy.</p></section>
  {error&&<p className="ps-error" role="alert">{error}</p>}{notice&&<p className="ps-success" role="status">{notice}</p>}
  <div className="ps-top"><label>Workspace<select value={workspaceId} onChange={e=>setWorkspaceId(e.target.value)}>{workspaces.map(w=><option key={w.id} value={w.id}>{w.name} · {w.role}</option>)}</select></label><button className="ps-quiet" onClick={()=>{setError('');refresh().catch(e=>setError(String(e)))}} disabled={busy||!workspaceId}>Refresh impact</button></div>
  {preview&&impact&&<>
   <div className="ps-stats"><article><strong>{preview.active_rules.length}</strong><span>Active rules</span></article><article><strong>{preview.test_passed}/{preview.tests.length}</strong><span>Regression cases passing</span></article><article><strong>{impact.retest_count}</strong><span>Drafts need retesting</span></article><article><strong>{impact.approvals_at_risk}</strong><span>Approvals need revalidation</span></article></div>
   <div className="ps-grid"><section className="ps-card"><span className="ps-kicker">01 / PROTOCOL STUDIO</span><h3>Publication desk</h3>
     <p className="ps-muted">Latest release: <b>{preview.current_release?`v${preview.current_release.number}`:'None yet'}</b> · Active policy {unchanged?'matches published snapshot':'has unpublished changes'}</p>
     <p className="ps-muted">Next release: <b>v{preview.next_number}</b></p>
     <div className="ps-change"><div><b>Added</b><span>{preview.change.added.join(', ')||'None'}</span></div><div><b>Modified</b><span>{preview.change.modified.join(', ')||'None'}</span></div><div><b>Removed</b><span>{preview.change.removed.join(', ')||'None'}</span></div></div>
     <h4>Active policy snapshot</h4><ul className="ps-list">{preview.active_rules.map(r=><li key={r.id}><b>{r.code}</b> — {r.title} <small>(rule v{r.version})</small></li>)}</ul>
     <h4>Regression results</h4>{preview.tests.length?<ul className="ps-list">{preview.tests.map(t=><li key={t.id}><b>{t.passed?'PASS':'FAIL'}</b> · {t.rule_code} · expected {String(t.expected_match)}, observed {String(t.actual_match)}</li>)}</ul>:<p className="ps-warn">No saved regression cases. Publishing is possible, but it does not demonstrate regression coverage.</p>}
     {workspace?.role==='admin'?<><label>Release note<textarea rows={3} maxLength={500} value={note} onChange={e=>setNote(e.target.value)} placeholder="What changed, and why?"/></label><button className="ps-primary" disabled={busy||!preview.eligible||unchanged||!note.trim()} onClick={publish}>Publish policy v{preview.next_number}</button></>:<p className="ps-muted">Only an authenticated workspace admin can publish a policy release.</p>}
     <p className="ps-muted ps-fine">Publishing snapshots the rules already active in Policy Vault. It does not change the rules or repair drafts.</p>
   </section>
   <section className="ps-card"><span className="ps-kicker">02 / RIPPLEMAP</span><h3>Draft impact map</h3>
    <p className="ps-muted">{impact.published_matches_active?'Current rules match the latest publication.':'Current active rules differ from the latest published release (or no release exists).'}</p>
    {impact.drafts.length===0?<p>No workspace drafts yet.</p>:<div className="ps-impact-list">{impact.drafts.map(d=><article className="ps-impact" key={d.draft_id}><div className="ps-impact-head"><b>{d.title}</b><span className={d.needs_retest?'ps-chip ps-attention':'ps-chip'}>{d.status.replaceAll('_',' ')}</span></div><p>Saved version {d.version} · {d.channel}{d.has_approval?' · previously approved':''}</p>{d.matched_rules.length>0&&<p>Current rule matches: <b>{d.matched_rules.join(', ')}</b></p>}{d.approval_needs_revalidation&&<p className="ps-warning">Existing approval requires revalidation under current policies.</p>}{onOpenDraft&&<button className="ps-quiet" onClick={()=>onOpenDraft(workspaceId,d.draft_id)}>Open in Workspace Control</button>}</article>)}</div>}
    <p className="ps-muted ps-fine">Impact indicates stale rule snapshots or possible regex matches. It does not revoke approvals or replace a full policy check.</p>
   </section></div>
   <section className="ps-card"><span className="ps-kicker">03 / RELEASE HISTORY</span><h3>Immutable policy ledger</h3>{releases.length===0?<p className="ps-muted">No published policy snapshots yet.</p>:<div className="ps-releases">{releases.map(r=><article key={r.id}><strong>Release v{r.number}</strong><span>{r.note}</span><small>{r.published_at}</small></article>)}</div>}</section>
  </>}
 </div>;
}
